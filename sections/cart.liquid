
{% comment %}
  Custom responsive Shopify cart section
{% endcomment %}

<section class="custom-cart">
  <div class="custom-cart__container">

    <h1 class="custom-cart__title">
      {{ 'cart.title' | t }}
    </h1>

    {% if cart.item_count == 0 %}
      <div class="custom-cart__empty">
        <p>Your cart is currently empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="custom-cart__button">
          Continue Shopping
        </a>
      </div>
    {% else %}

      <form action="{{ routes.cart_url }}" method="post">

        <div class="custom-cart__table-wrap">
          <table class="custom-cart__table">
            <thead>
              <tr>
                <th scope="col">Product</th>
                <th scope="col">Details</th>
                <th scope="col">Quantity</th>
                <th scope="col">Total</th>
              </tr>
            </thead>

            <tbody>
              {% for item in cart.items %}
                <tr>
                  <td class="custom-cart__image">
                    {% if item.image %}
                      <a href="{{ item.url }}">
                        {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.product.title }}
                      </a>
                    {% endif %}
                  </td>

                  <td class="custom-cart__details">
                    <a href="{{ item.url }}" class="custom-cart__product-title">
                      {{ item.product.title | escape }}
                    </a>

                    {% unless item.variant.title == 'Default Title' %}
                      <p class="custom-cart__variant">
                        {{ item.variant.title | escape }}
                      </p>
                    {% endunless %}

                    <p class="custom-cart__price">
                      {{ item.final_price | money }}
                    </p>

                    <a href="{{ item.url_to_remove }}" class="custom-cart__remove">
                      Remove
                    </a>
                  </td>

                  <td>
                    <label class="custom-cart__quantity-label" for="quantity-{{ item.key }}">
                      Quantity
                    </label>
                    <input
                      id="quantity-{{ item.key }}"
                      class="custom-cart__quantity"
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      step="1"
                    >
                  </td>

                  <td class="custom-cart__line-price">
                    {{ item.final_line_price | money }}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <div class="custom-cart__bottom">
          <button type="submit" name="update" class="custom-cart__update">
            Update Cart
          </button>

          <div class="custom-cart__summary">
            <p class="custom-cart__subtotal">
              <span>Subtotal</span>
              <strong>{{ cart.total_price | money }}</strong>
            </p>

            <p class="custom-cart__note">
              Shipping and taxes calculated at checkout.
            </p>

            <button type="submit" name="checkout" class="custom-cart__checkout">
              {{ 'cart.checkout' | t }}
            </button>

            <a href="{{ routes.all_products_collection_url }}" class="custom-cart__continue">
              Continue Shopping
            </a>
          </div>
        </div>

      </form>
    {% endif %}

  </div>
</section>

<style>
  .custom-cart {
    background: #f8f7f4;
    padding: 56px 20px 72px;
    color: #222b2a;
  }

  .custom-cart__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .custom-cart__title {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.2;
    margin: 0 0 36px;
    font-weight: 700;
    color: #203d3a;
  }

  .custom-cart__table-wrap {
    overflow-x: auto;
    background: #fff;
    border: 1px solid #e5e5df;
    border-radius: 14px;
  }

  .custom-cart__table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .custom-cart__table th {
    padding: 18px;
    background: #203d3a;
    color: #fff;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .custom-cart__table td {
    padding: 20px 18px;
    border-bottom: 1px solid #e9e9e3;
    vertical-align: middle;
  }

  .custom-cart__table tbody tr:last-child td {
    border-bottom: 0;
  }

  .custom-cart__image img {
    display: block;
    width: 100px;
    height: 110px;
    object-fit: cover;
    border-radius: 9px;
  }

  .custom-cart__product-title {
    color: #203d3a;
    font-weight: 700;
    text-decoration: none;
  }

  .custom-cart__product-title:hover {
    color: #a66c48;
  }

  .custom-cart__variant {
    color: #727772;
    font-size: 13px;
    margin: 7px 0;
  }

  .custom-cart__price,
  .custom-cart__line-price {
    font-weight: 700;
    color: #2c514e;
  }

  .custom-cart__remove {
    display: inline-block;
    margin-top: 10px;
    color: #a33c36;
    font-size: 13px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .custom-cart__quantity-label {
    display: block;
    font-size: 12px;
    margin-bottom: 6px;
  }

  .custom-cart__quantity {
    width: 76px;
    min-height: 44px;
    padding: 8px;
    border: 1px solid #d8dcd5;
    border-radius: 7px;
    background: #fff;
    color: #222b2a;
  }

  .custom-cart__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 30px;
    margin-top: 26px;
  }

  .custom-cart__summary {
    width: min(100%, 380px);
    padding: 26px;
    background: #fff;
    border: 1px solid #e5e5df;
    border-radius: 14px;
  }

  .custom-cart__subtotal {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 19px;
    margin: 0;
  }

  .custom-cart__subtotal strong {
    color: #203d3a;
  }

  .custom-cart__note {
    color: #747872;
    font-size: 13px;
    margin: 12px 0 22px;
  }

  .custom-cart__button,
  .custom-cart__checkout,
  .custom-cart__update {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 22px;
    border: 0;
    border-radius: 7px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .custom-cart__button,
  .custom-cart__checkout {
    background: #2c514e;
    color: #fff;
  }

  .custom-cart__checkout {
    width: 100%;
  }

  .custom-cart__button:hover,
  .custom-cart__checkout:hover {
    background: #203d3a;
    color: #fff;
    transform: translateY(-1px);
  }

  .custom-cart__update {
    background: #e8ece8;
    color: #203d3a;
  }

  .custom-cart__update:hover {
    background: #d9e1dc;
  }

  .custom-cart__continue {
    display: block;
    text-align: center;
    color: #2c514e;
    font-size: 14px;
    margin-top: 18px;
  }

  .custom-cart__empty {
    text-align: center;
    padding: 56px 20px;
    background: #fff;
    border: 1px solid #e5e5df;
    border-radius: 14px;
  }

  .custom-cart__empty p {
    margin: 0 0 22px;
    font-size: 18px;
  }

  @media screen and (max-width: 749px) {
    .custom-cart {
      padding: 34px 14px 48px;
    }

    .custom-cart__title {
      margin-bottom: 24px;
    }

    .custom-cart__table {
      min-width: 660px;
    }

    .custom-cart__table th,
    .custom-cart__table td {
      padding: 13px;
    }

    .custom-cart__image img {
      width: 76px;
      height: 86px;
    }

    .custom-cart__bottom {
      flex-direction: column;
      gap: 20px;
    }

    .custom-cart__update,
    .custom-cart__summary {
      width: 100%;
    }

    .custom-cart__summary {
      padding: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Cart",
  "settings": [],
  "presets": [
    {
      "name": "Custom Cart"
    }
  ]
}
{% endschema %}
